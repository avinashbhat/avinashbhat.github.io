---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  displayTitle?: string;
  pageClass?: string;
  date?: string;
  frontmatter?: {
    title: string;
    pageClass?: string;
    date?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title || Astro.props.title;
const displayTitle = Astro.props.displayTitle;
const pageClass = frontmatter?.pageClass || Astro.props.pageClass;
const date = frontmatter?.date || Astro.props.date;

// Every page except the home page offers a way back to it. Essays return to the
// tab they were listed under; anything else (404 included) goes to the top.
const path = Astro.url.pathname.replace(/\/$/, '');
const isHome = path === '' || path === '/about';
const homeHref = pageClass === 'essay-content-page' ? '/about#essays' : '/about';
---

<BaseLayout title={title}>
  <section class={`post ${pageClass || ''}`}>
    <header class="page-header">
      <div>
        {displayTitle
          ? <h2 class="page-title" set:html={displayTitle} />
          : <h2 class="page-title">{title}</h2>
        }
        {pageClass === 'essay-content-page' && date && (
          <p class="page-date">{date}</p>
        )}
      </div>

      <div class="page-actions">
        {!isHome && (
          <a href={homeHref} class="btn btn-back" aria-label="Back to home" title="Back to home">
            <i class="fa-solid fa-house fa-fw"></i>
          </a>
        )}
        <button id="theme-toggle" class="btn btn-theme">
          <i class="fa-solid fa-moon"></i>
        </button>
      </div>
    </header>

    <slot />
  </section>
</BaseLayout>
