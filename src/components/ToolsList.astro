---
import toolsData from '../data/tools.json';

interface Tool {
  name: string;
  year?: number;
  description?: string;
  url: string;
}
---

<ul class="content-list">
  {toolsData.map((tool: Tool, index: number) => (
    <li class="content-item">
      {/* Same grouping as the publications list: a year prints once, and the
          rest of its group reveals it on hover or click. */}
      {tool.year && (
        <div class={index > 0 && toolsData[index - 1].year === tool.year
          ? 'content-item-label is-repeat-year'
          : 'content-item-label'}>
          {tool.year}
        </div>
      )}
      <div class="content-item-body">
        <div class="content-item-preview">
          {tool.name}
        </div>
        <div class="content-item-details">
          <div class="pub-venue">
            {tool.description && <span class="tool-description">{tool.description}</span>}
            <a href={tool.url} target="_blank" rel="noopener noreferrer" class="pub-link-badge">
              <i class="fa-brands fa-github"></i> GitHub
            </a>
          </div>
        </div>
      </div>
    </li>
  ))}
</ul>
